{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "plain": {
      "type": "stdio",
      "command": "node",
      "args": [
        "bin/npx.mjs",
        "-y",
        "--package=@gabe4coding/plain@3.1.0",
        "plain",
        "--headless",
        "mcp"
