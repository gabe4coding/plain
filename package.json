{
  "name": "jev-e2e",
  "version": "1.0.0",
  "description": "YAML-driven end-to-end browser tests, with Jev resolving natural-language steps and expectations",
  "type": "module",
  "bin": {
    "jev-e2e": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test 'dist/**/*.test.js'",
    "example": "npm run build && node dist/cli.js examples/*.yaml"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.107",
    "playwright": "^1.63.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
