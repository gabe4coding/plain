# Copy to .env — one of the two keys is enough. TYPESAFE_API_KEY wins when both are set.
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
# Optional: force a backend
# JEV_PROVIDER=typesafe|gateway
# Optional: mobile Appium server (also configurable with --server)
# PLAIN_APPIUM_URL=http://127.0.0.1:4723
# Optional: turn off step `changed` diffs (on by default)
# PLAIN_CHANGES=0
# Optional: hide the MCP `read` tool (on by default)
# PLAIN_READ=0
# Optional: the public demo passwords that examples/login.yaml and examples/components-auth.yaml read
DEMO_PASSWORD=SuperSecretPassword!
DEMO_BASIC_PASS=admin
